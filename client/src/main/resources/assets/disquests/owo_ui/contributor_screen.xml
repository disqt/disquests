<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.21/owo-ui.xsd">

    <components>
    <flow-layout direction="vertical" id="root">
        <sizing>
            <horizontal method="fill">100</horizontal>
            <vertical method="fill">100</vertical>
        </sizing>
        <surface>
            <vanilla-translucent/>
        </surface>
        <horizontal-alignment>center</horizontal-alignment>
        <padding>
            <all>0</all>
            <top>8</top>
        </padding>

        <children>

            <!-- Header row: back arrow + title -->
            <flow-layout direction="horizontal" id="header-row">
                <sizing>
                    <horizontal method="fill">85</horizontal>
                    <vertical method="content"/>
                </sizing>
                <vertical-alignment>center</vertical-alignment>
                <margins>
                    <bottom>6</bottom>
                </margins>
                <children>
                    <button id="btn-back">
                        <text>&lt;</text>
                        <sizing>
                            <horizontal method="fixed">20</horizontal>
                            <vertical method="fixed">20</vertical>
                        </sizing>
                    </button>
                    <label id="title-label">
                        <text>Contributors</text>
                        <shadow>true</shadow>
                        <sizing>
                            <horizontal method="content"/>
                            <vertical method="content"/>
                        </sizing>
                        <margins>
                            <left>4</left>
                        </margins>
                    </label>
                </children>
            </flow-layout>

            <!-- Pending requests section (removed when empty) -->
            <flow-layout direction="vertical" id="pending-section">
                <sizing>
                    <horizontal method="fill">85</horizontal>
                    <vertical method="content"/>
                </sizing>
                <gap>2</gap>
                <margins>
                    <bottom>6</bottom>
                </margins>
                <children>
                    <label id="pending-header">
                        <text>Pending Requests</text>
                        <shadow>true</shadow>
                        <color>#FFAA33</color>
                    </label>
                    <!-- Pending entries added programmatically -->
                    <template name="dark-panel@disquests:templates">
                        <panel-id>pending-list</panel-id>
                        <width>100</width>
                        <padding-val>4</padding-val>
                        <gap-val>2</gap-val>
                    </template>
                </children>
            </flow-layout>

            <!-- Contributor list (scrollable) -->
            <template name="scrollable-list@disquests:templates">
                <scroll-id>contributor-scroll</scroll-id>
                <list-id>contributor-list</list-id>
                <width>85</width>
                <height>40</height>
            </template>

            <!-- Add row: name field, role choice and Add, filled programmatically (owners, V4 servers) -->
            <flow-layout direction="horizontal" id="add-person-row">
                <sizing>
                    <horizontal method="fill">85</horizontal>
                    <vertical method="content"/>
                </sizing>
                <vertical-alignment>center</vertical-alignment>
                <gap>4</gap>
                <margins>
                    <top>4</top>
                </margins>
                <children/>
            </flow-layout>

            <!-- What the roles allow, and that nothing changes until Save (texts set programmatically),
                 on a dark panel so the muted lines read against the world -->
            <flow-layout direction="vertical" id="people-hints">
                <sizing>
                    <horizontal method="fill">85</horizontal>
                    <vertical method="content"/>
                </sizing>
                <surface>
                    <panel dark="true"/>
                </surface>
                <padding>
                    <all>4</all>
                </padding>
                <gap>2</gap>
                <margins>
                    <top>4</top>
                </margins>
                <children>
                    <label id="people-roles-hint">
                        <text>-</text>
                        <shadow>true</shadow>
                        <sizing>
                            <horizontal method="fill">100</horizontal>
                            <vertical method="content"/>
                        </sizing>
                    </label>
                    <label id="people-save-hint">
                        <text>-</text>
                        <shadow>true</shadow>
                        <sizing>
                            <horizontal method="fill">100</horizontal>
                            <vertical method="content"/>
                        </sizing>
                    </label>
                </children>
            </flow-layout>

            <!-- Save and Cancel (texts set programmatically) -->
            <flow-layout direction="horizontal" id="people-buttons">
                <sizing>
                    <horizontal method="content"/>
                    <vertical method="content"/>
                </sizing>
                <gap>4</gap>
                <margins>
                    <top>6</top>
                </margins>
                <children>
                    <button id="btn-save-people">
                        <text>Save</text>
                        <sizing>
                            <horizontal method="fixed">80</horizontal>
                            <vertical method="fixed">20</vertical>
                        </sizing>
                    </button>
                    <button id="btn-cancel-people">
                        <text>Cancel</text>
                        <sizing>
                            <horizontal method="fixed">80</horizontal>
                            <vertical method="fixed">20</vertical>
                        </sizing>
                    </button>
                </children>
            </flow-layout>

            <!-- Empty label (pre-trees servers: shown when no contributors and no pending) -->
            <label id="empty-label">
                <text>No contributors yet</text>
                <shadow>true</shadow>
                <sizing>
                    <horizontal method="content"/>
                    <vertical method="content"/>
                </sizing>
                <margins>
                    <top>10</top>
                </margins>
            </label>


        </children>
    </flow-layout>
    </components>

</owo-ui>
