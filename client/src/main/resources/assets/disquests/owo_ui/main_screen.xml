<owo-ui xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/wisp-forest/owo-lib/1.21/owo-ui.xsd">

    <components>
    <!-- Root: horizontal flow, map area on the left, quest side panel on the right -->
    <flow-layout direction="horizontal" id="root">
        <sizing>
            <horizontal method="fill">100</horizontal>
            <vertical method="fill">100</vertical>
        </sizing>
        <surface>
            <vanilla-translucent/>
        </surface>

        <children>

            <!-- Map area: toolbar above the map slot, takes the width left by the panel -->
            <flow-layout direction="vertical" id="map-area">
                <sizing>
                    <horizontal method="expand">100</horizontal>
                    <vertical method="fill">100</vertical>
                </sizing>
                <children>

                    <flow-layout direction="horizontal" id="map-toolbar">
                        <sizing>
                            <horizontal method="fill">100</horizontal>
                            <vertical method="content"/>
                        </sizing>
                        <gap>4</gap>
                        <padding>
                            <all>4</all>
                        </padding>
                        <vertical-alignment>center</vertical-alignment>
                        <children>
                            <!-- Button texts and tooltips are set from lang keys in MainScreen.
                                 The dimension buttons live in the dimension-menu popup, built in code. -->
                            <button id="btn-dimension">
                                <text>Overworld</text>
                                <sizing>
                                    <horizontal method="content"/>
                                    <vertical method="fixed">14</vertical>
                                </sizing>
                            </button>
                            <button id="btn-centre-me">
                                <text>Centre on me</text>
                                <sizing>
                                    <horizontal method="content"/>
                                    <vertical method="fixed">14</vertical>
                                </sizing>
                            </button>
                            <button id="btn-zoom-out">
                                <text>−</text>
                                <sizing>
                                    <horizontal method="fixed">14</horizontal>
                                    <vertical method="fixed">14</vertical>
                                </sizing>
                            </button>
                            <button id="btn-zoom-in">
                                <text>+</text>
                                <sizing>
                                    <horizontal method="fixed">14</horizontal>
                                    <vertical method="fixed">14</vertical>
                                </sizing>
                            </button>
                            <!-- Spacer: pushes the List toggle to the right edge of the map area -->
                            <flow-layout direction="horizontal" id="map-toolbar-spacer">
                                <sizing>
                                    <horizontal method="expand">100</horizontal>
                                    <vertical method="fixed">1</vertical>
                                </sizing>
                                <children/>
                            </flow-layout>
                            <button id="btn-toggle-list">
                                <text>List</text>
                                <sizing>
                                    <horizontal method="content"/>
                                    <vertical method="fixed">14</vertical>
                                </sizing>
                            </button>
                        </children>
                    </flow-layout>

                    <!-- MapView (id map-view) is added here programmatically -->
                    <flow-layout direction="vertical" id="map-slot">
                        <sizing>
                            <horizontal method="fill">100</horizontal>
                            <vertical method="expand">100</vertical>
                        </sizing>
                        <children/>
                    </flow-layout>

                </children>
            </flow-layout>

            <!-- Side panel: header, tabs, filters, search, quest list, actions.
                 Its width is set from the config and the panel-divider drag in MainScreen. -->
            <flow-layout direction="vertical" id="side-panel">
                <sizing>
                    <horizontal method="fixed">216</horizontal>
                    <vertical method="fill">100</vertical>
                </sizing>
                <surface>
                    <panel dark="true"/>
                </surface>
                <padding>
                    <all>4</all>
                </padding>

                <children>

                    <!-- Header row: back arrow + title -->
                    <flow-layout direction="horizontal" id="header-row">
                        <sizing>
                            <horizontal method="fill">100</horizontal>
                            <vertical method="content"/>
                        </sizing>
                        <vertical-alignment>center</vertical-alignment>
                        <margins>
                            <bottom>4</bottom>
                        </margins>
                        <children>
                            <button id="btn-back">
                                <text>&lt;</text>
                                <sizing>
                                    <horizontal method="fixed">20</horizontal>
                                    <vertical method="fixed">20</vertical>
                                </sizing>
                            </button>
                            <label id="title-label">
                                <text>Disquests</text>
                                <shadow>true</shadow>
                                <sizing>
                                    <horizontal method="content"/>
                                    <vertical method="content"/>
                                </sizing>
                                <margins>
                                    <left>4</left>
                                </margins>
                            </label>
                            <button id="btn-toggle-map">
                                <text>Map</text>
                                <sizing>
                                    <horizontal method="content"/>
                                    <vertical method="fixed">20</vertical>
                                </sizing>
                                <margins>
                                    <left>4</left>
                                </margins>
                            </button>
                        </children>
                    </flow-layout>

                    <!-- Tab row: tabs share the row width; MainScreen sets each one's expand
                         percentage from the number of tabs present -->
                    <flow-layout direction="horizontal" id="tab-row">
                        <sizing>
                            <horizontal method="fill">100</horizontal>
                            <vertical method="content"/>
                        </sizing>
                        <gap>2</gap>
                        <margins>
                            <bottom>2</bottom>
                        </margins>
                        <children>
                            <button id="tab-my-quests">
                                <text>My Quests</text>
                                <sizing>
                                    <horizontal method="expand">33</horizontal>
                                    <vertical method="fixed">20</vertical>
                                </sizing>
                            </button>
                            <button id="tab-quest-board">
                                <text>Quest Board</text>
                                <sizing>
                                    <horizontal method="expand">33</horizontal>
                                    <vertical method="fixed">20</vertical>
                                </sizing>
                            </button>
                            <!-- Text set from a lang key in MainScreen -->
                            <button id="tab-archived">
                                <text>Archived</text>
                                <sizing>
                                    <horizontal method="expand">33</horizontal>
                                    <vertical method="fixed">20</vertical>
                                </sizing>
                            </button>
                        </children>
                    </flow-layout>

                    <!-- Filter row (Server Quests tab only) -->
                    <flow-layout direction="horizontal" id="filter-row">
                        <sizing>
                            <horizontal method="content"/>
                            <vertical method="content"/>
                        </sizing>
                        <gap>4</gap>
                        <margins>
                            <bottom>2</bottom>
                        </margins>
                        <children>
                            <button id="filter-all">
                                <text>All</text>
                                <sizing>
                                    <horizontal method="fixed">50</horizontal>
                                    <vertical method="fixed">14</vertical>
                                </sizing>
                            </button>
                            <button id="filter-open">
                                <text>Open</text>
                                <sizing>
                                    <horizontal method="fixed">50</horizontal>
                                    <vertical method="fixed">14</vertical>
                                </sizing>
                            </button>
                            <button id="filter-closed">
                                <text>Closed</text>
                                <sizing>
                                    <horizontal method="fixed">50</horizontal>
                                    <vertical method="fixed">14</vertical>
                                </sizing>
                            </button>
                        </children>
                    </flow-layout>

                    <!-- Search row: TextBox added programmatically -->
                    <flow-layout direction="horizontal" id="search-row">
                        <sizing>
                            <horizontal method="fill">100</horizontal>
                            <vertical method="content"/>
                        </sizing>
                        <margins>
                            <bottom>4</bottom>
                        </margins>
                        <children/>
                    </flow-layout>

                    <!-- Quest list, inline because the template only supports fill heights.
                         The child MUST be the first element of the scroll container. -->
                    <scroll direction="vertical" id="quest-scroll">
                        <flow-layout direction="vertical" id="quest-list">
                            <sizing>
                                <horizontal method="fill">100</horizontal>
                                <vertical method="content"/>
                            </sizing>
                            <gap>2</gap>
                        </flow-layout>
                        <sizing>
                            <horizontal method="fill">100</horizontal>
                            <vertical method="expand">100</vertical>
                        </sizing>
                        <surface>
                            <panel dark="true"/>
                        </surface>
                        <padding>
                            <all>4</all>
                        </padding>
                    </scroll>

                    <!-- Action button row -->
                    <flow-layout direction="horizontal" id="action-row">
                        <sizing>
                            <horizontal method="fill">100</horizontal>
                            <vertical method="content"/>
                        </sizing>
                        <gap>4</gap>
                        <margins>
                            <top>4</top>
                        </margins>
                        <children>
                            <button id="btn-new-quest">
                                <text>New Quest</text>
                                <sizing>
                                    <horizontal method="expand">33</horizontal>
                                    <vertical method="fixed">20</vertical>
                                </sizing>
                            </button>
                            <button id="btn-interact">
                                <text>Join</text>
                                <sizing>
                                    <horizontal method="expand">33</horizontal>
                                    <vertical method="fixed">20</vertical>
                                </sizing>
                            </button>
                            <button id="btn-open">
                                <text>Open</text>
                                <sizing>
                                    <horizontal method="expand">33</horizontal>
                                    <vertical method="fixed">20</vertical>
                                </sizing>
                            </button>
                        </children>
                    </flow-layout>

                </children>
            </flow-layout>

        </children>
    </flow-layout>
    </components>

</owo-ui>
